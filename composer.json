{
  "name": "talalalmrka/fgx",
  "description": "Reusable UI Components for Laravel by fadgram",
  "keywords": [
    "fgx",
    "fadgram",
    "laravel",
    "livewire",
    "components",
    "ui"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "talalalmrka",
      "email": "talalminfo@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/view": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "livewire/livewire": "^3.0|^4.0",
    "spatie/laravel-medialibrary": "^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.5",
    "spatie/laravel-ray": "^1.25"
  },
  "autoload": {
    "psr-4": {
      "Fgx\\": "src/"
    },
    "files": [
      "src/Helpers/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fgx\\Providers\\FgxServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
